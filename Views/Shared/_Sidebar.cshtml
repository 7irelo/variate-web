@using Microsoft.EntityFrameworkCore
@inject variate.Data.ApplicationDbContext Db
@{
    // Only categories that have products, so no link leads to an empty page.
    var categories = await Db.Categories.AsNoTracking()
        .Where(c => Db.Products.Any(p => p.CategoryId == c.Id))
        .OrderBy(c => c.Name)
        .ToListAsync();
}
<nav class="navbar navbar-expand-md bg-body py-3" style="display: flex;">
    <div class="container">
        <div class="collapse navbar-collapse" id="navcol-3" style="display: flex;">
            <ul class="navbar-nav mx-auto" style="display: flex;">
                <li class="nav-item" style="display: inline;">
                    @foreach (var category in categories)
                    {
                        <a class="nav-link" href="@Url.Action("Details", "Category", new { id = category.Id })" style="display: flex;">@category.Name</a>
                    }
                </li>
            </ul>
        </div>
    </div>
</nav>
