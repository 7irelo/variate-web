@model List<Order>
@{
    ViewData["Title"] = "My orders";
}

<section class="py-5 container">
    <h1 class="mb-4">@(User.IsInRole("admin") ? "All orders" : "My orders")</h1>
    @if (Model.Count == 0)
    {
        <p>You haven't placed any orders yet.</p>
        <a class="btn btn-primary" asp-controller="Product" asp-action="Index">Start shopping</a>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Items</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@order.Id">#@order.Id</a></td>
                            <td>@order.OrderDateTime.ToString("d MMM yyyy, HH:mm")</td>
                            <td>@OrderStatus.Label(order.Status)</td>
                            <td>@order.OrderItems.Sum(i => i.Quantity)</td>
                            <td class="text-end">R@(order.TotalCost.ToString("0.00"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
