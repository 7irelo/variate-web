@model Order
@{
    ViewData["Title"] = $"Order #{Model.Id}";
}

<section class="py-5 container">
    <a asp-action="Index">&larr; All orders</a>
    <h1 class="mt-3">Order #@Model.Id</h1>
    <p class="text-muted">
        Placed @Model.OrderDateTime.ToString("d MMM yyyy, HH:mm") &middot; <strong>@OrderStatus.Label(Model.Status)</strong>
        @if (User.IsInRole("admin") && Model.ApplicationUser != null)
        {
            <span>&middot; @Model.ApplicationUser.Email</span>
        }
    </p>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">Quantity</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderItems)
                {
                    <tr>
                        <td>
                            @if (item.Product != null)
                            {
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId">@item.Product.Brand @item.Product.Name</a>
                            }
                            else
                            {
                                <span>Product no longer available</span>
                            }
                        </td>
                        <td class="text-end">R@(item.UnitPrice.ToString("0.00"))</td>
                        <td class="text-end">@item.Quantity</td>
                        <td class="text-end">R@((item.UnitPrice * item.Quantity).ToString("0.00"))</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Total</th>
                    <th class="text-end">R@(Model.TotalCost.ToString("0.00"))</th>
                </tr>
            </tfoot>
        </table>
    </div>

    @if (Model.Status == variate.Services.CheckoutService.PendingPayment)
    {
        <p class="text-muted">This order hasn't been paid. Orders are only processed once payment is confirmed.</p>
    }
</section>
