@{
    ViewData["Title"] = "Returns and refunds";
}

<section class="py-5 container" style="max-width: 760px;">
    <h1>@ViewData["Title"]</h1>

    <h2 class="h5 mt-4">Returning an item</h2>
    <p>You can return most items within 30 days of delivery if they are unused and in their original packaging.
        To start a return, <a asp-action="Contact">contact us</a> with your order number.</p>

    <h2 class="h5 mt-4">Refunds</h2>
    <p>Refunds go back to the original payment method within 5&ndash;10 working days of the item reaching our warehouse.</p>

    <h2 class="h5 mt-4">Damaged or incorrect items</h2>
    <p>If an item arrives damaged or isn't what you ordered, we collect it free of charge.</p>
</section>
