@model Cart
@{
    ViewData["Title"] = "Your Cart";
}

<section class="py-5 container">
    <div data-reflow-type="shopping-cart">
        <div class="reflow-shopping-cart" style="display: block;">
            <div class="ref-loading-overlay"></div>
            <div class="ref-message" style="display: none;">Unable to load shopping cart.</div>
            <div class="ref-cart" style="display: block;">
                <div class="ref-heading">Shopping Cart</div>
                @if (TempData["CheckoutError"] is string checkoutError)
                {
                    <div class="alert alert-warning">@checkoutError</div>
                }
                <div class="ref-th">
                    <div class="ref-product-col">Product</div>
                    <div class="ref-price-col">Price</div>
                    <div class="ref-quantity-col">Quantity</div>
                    <div class="ref-total-col">Total</div>
                </div>
                <div class="ref-cart-table">
                    @foreach (var product in Model.CartItems)
                    {
                        <div class="ref-product" data-id="@product.Id" data-quantity="@product.Quantity">
                            @* Both quantity widgets (mobile and desktop) submit through this form. *@
                            <form id="qty-@product.Id" class="js-quantity-form" asp-controller="Cart" asp-action="UpdateQuantity" asp-route-itemId="@product.Id" method="post" hidden></form>
                            <div class="ref-product-col">
                                <div class="ref-product-wrapper">
                                    <img class="ref-product-photo" src="~/img/products/@(product.Product?.ImageUrl ?? new string("default.jpg"))" alt="@product.Product?.Name" />
                                    <div class="ref-product-data">
                                        <div class="ref-product-info">
                                            <div>
                                                <div class="ref-product-name">@product.Product?.Name</div>
                                                <div class="ref-product-category">@product.Product?.Category?.Name</div>
                                            </div>
                                            <div class="ref-product-price ref-mobile-product-price">
                                                R@(string.Format("{0:0.00}", product.Product?.EffectivePrice))
                                            </div>
                                        </div>
                                        <div class="ref-product-controls ref-mobile-product-controls">
                                            <div class="ref-product-quantity">
                                                <div class="ref-quantity-widget">
                                                    <button type="submit" form="qty-@product.Id" name="delta" value="-1" class="ref-decrease" aria-label="Decrease quantity" @(product.Quantity <= 1 ? "disabled" : "")><span></span></button>
                                                    <input type="text" value="@product.Quantity" aria-label="Quantity" readonly />
                                                    <button type="submit" form="qty-@product.Id" name="delta" value="1" class="ref-increase" aria-label="Increase quantity"><span></span></button>
                                                </div>
                                            </div>
                                            <form asp-controller="Cart" asp-action="Delete" asp-route-id="@product.Id" method="post">
                                                <button class="ref-product-remove" type="submit" style="border: none; background-color: white;">Remove</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="ref-price-col">
                                <div class="ref-product-price">
                                    R@(string.Format("{0:0.00}", product.Product?.EffectivePrice))
                                </div>
                            </div>
                            <div class="ref-quantity-col">
                                <div class="ref-product-quantity">
                                    <div class="ref-quantity-container">
                                        <div class="ref-quantity-widget">
                                            <button type="submit" form="qty-@product.Id" name="delta" value="-1" class="ref-decrease" aria-label="Decrease quantity" @(product.Quantity <= 1 ? "disabled" : "")><span></span></button>
                                            <input type="text" value="@product.Quantity" aria-label="Quantity" readonly />
                                            <button type="submit" form="qty-@product.Id" name="delta" value="1" class="ref-increase" aria-label="Increase quantity"><span></span></button>
                                        </div>
                                    </div>
                                    <div class="ref-product-qty-message"></div>
                                    <form asp-controller="cart" asp-action="delete" asp-route-id="@product.Id" method="POST">
                                        <button class="ref-product-remove" type="submit" style="border: none; background-color: white;">Remove</button>
                                        </form>
                                </div>
                            </div>
                            <div class="ref-total-col">
                                <div class="ref-product-total">
                                    <div class="ref-product-total-sum">
                                        R@(string.Format("{0:0.00}", product.Product?.EffectivePrice * product.Quantity))
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="ref-footer">
                    <div class="ref-totals">
                        <div class="ref-subtotal">
                            Subtotal: <span id="cart-subtotal">R@(string.Format("{0:0.00}", Model.CartItems.Sum(item => item.Product?.EffectivePrice * item.Quantity)))</span>
                        </div>
                    </div>
                    <form asp-controller="Checkout" asp-action="Start" method="post">
                        <div class="ref-accept-terms" style="display: block;">
                            <label>
                                <input id="ref-terms-agreement" name="acceptTerms" type="checkbox" value="true" required />
                                <span class="ref-terms-agreement-text">
                                    I agree to the <a asp-controller="Home" asp-action="Terms" target="_blank">Terms &amp; Conditions</a>,
                                    <a asp-controller="Home" asp-action="Privacy" target="_blank">Privacy Policy</a> and 
                                    <a asp-controller="Home" asp-action="Returns" target="_blank">Refund Policy</a>
                                </span>
                            </label>
                        </div>
                        <div class="ref-row ref-checkout-buttons">
                            <button type="submit" class="ref-button ref-standard-checkout-button" @(Model.CartItems.Count == 0 ? "disabled" : "")>Checkout</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>


<style>
    /* The reflow toolkit only styles div children (.ref-quantity-widget > div); give the buttons the same box. */
    .ref-quantity-widget > button {
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0;
        border: 0 solid;
        border-color: inherit;
        border-radius: 0;
        background: none;
        color: inherit;
        cursor: pointer;
        font-size: 1.1em;
        line-height: 1.5em;
        width: 1.6em;
        min-width: 32px;
        padding: var(--ref-input-padding);
    }
    .ref-quantity-widget > button:active { background-color: #979ca01a; }
    .ref-quantity-widget > button:disabled { opacity: .4; cursor: default; background: none; }
</style>

@section Scripts {
    <script>
        // Update quantities in place. Without JavaScript the form posts normally.
        // If the request fails, reload so the page shows what the server has
        // (resubmitting could apply the change twice).
        document.querySelectorAll('.js-quantity-form').forEach(form => {
            form.addEventListener('submit', async event => {
                const submitter = event.submitter;
                if (!submitter) return;
                event.preventDefault();

                const row = form.closest('.ref-product');
                const buttons = row.querySelectorAll('.ref-quantity-widget button');
                const body = new FormData(form);
                body.append(submitter.name, submitter.value);
                buttons.forEach(button => button.disabled = true);

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body,
                        headers: { Accept: 'application/json' },
                        credentials: 'same-origin'
                    });
                    if (!response.ok) throw new Error(`HTTP ${response.status}`);
                    const cart = await response.json();

                    row.dataset.quantity = cart.quantity;
                    row.querySelectorAll('.ref-quantity-widget input').forEach(input => input.value = cart.quantity);
                    row.querySelector('.ref-product-total-sum').textContent = cart.lineTotal;
                    document.getElementById('cart-subtotal').textContent = cart.subtotal;
                    const badge = document.getElementById('cart-count');
                    if (badge) badge.textContent = cart.itemCount;
                    buttons.forEach(button => button.disabled = button.value === '-1' && cart.quantity <= 1);
                } catch (error) {
                    console.error('Could not update quantity:', error);
                    location.reload();
                }
            });
        });
    </script>
}
